+                'new_status' => $log->new_status,
+                'payment_submission_id' => $log->payment_submission_id,
+                'reason' => $log->reason,
+                'created_at' => $log->created_at?->toDateTimeString(),
+            ])
+            ->values();
+
+        return response()->json(['logs' => $logs]);
+    }
