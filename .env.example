APP_NAME="Circle of Peer Facilitators (CPF)"
APP_ENV=local
APP_KEY=base64:s/X+rSQAoPYEqO7YMh/7S1Wg6MW2R4NLmAphnY6+Vjg=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Configured for Laragon MySQL / MariaDB out of the box:
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpf
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=86400
# Production hardening: set SESSION_ENCRYPT=true in production environments
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Production hardening: set BROADCAST_CONNECTION=reverb when running Laravel Reverb WebSockets
BROADCAST_CONNECTION=log
# BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@cpf.chmsu.edu.ph"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# === CPF Prototype Isolation (Separate from Main Code Proper) ===
CPF_PROTOTYPE_ENABLED=true
CPF_PROTOTYPE_PREFIX=prototype

# === CPF Blockchain Credentials Environment (Achievements, Certificates, Awards) ===
BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_DRIVER=local_ledger
BLOCKCHAIN_NETWORK=cpf-local-chain
BLOCKCHAIN_CHAIN_ID=80002
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_ISSUER_ADDRESS=
BLOCKCHAIN_EXPLORER_BASE_URL=https://amoy.polygonscan.com/tx/
BLOCKCHAIN_HASH_ALGORITHM=sha256

# === CPF Google Forms Webhook Connector ===
GOOGLE_FORMS_WEBHOOK_SECRET=cpf-local-forms-secret
